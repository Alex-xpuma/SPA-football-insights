# Copy this file to server/.env before running docker-compose

# Node.js API
PORT=5000

# AI prediction service (name of the Docker service)
AI_URL=http://ai:5000

# PostgreSQL (values match the db service in docker-compose.yml)
DB_HOST=postgres-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=fifa
